rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    function validUpload() {
      return request.resource != null
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType != null;
    }

    match /ita-contract-public/{documentId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validUpload();
      allow delete: if isAdmin();
    }

    match /ita-contract-drafts/{documentId}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validUpload();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
